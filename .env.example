# Optional site origin for metadata and CSRF checks.
# Leave unset on Vercel — the app uses VERCEL_URL automatically.
# Local example:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example (optional once you have a custom domain):
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery through https://web3forms.com.
# Web3Forms' free plan only accepts browser submissions, so this key is public by design
# (it can only send email to the inbox it was created for). Create it at web3forms.com
# using support@infotainmentacademy.live. Leave unset locally to skip sending.
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key
